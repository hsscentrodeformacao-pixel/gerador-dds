# Copie para .env.local (no seu computador) e preencha.
# Na Vercel, cadastre as mesmas variáveis em Settings > Environment Variables.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Claude (console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=
# Modelo usado para escrever o DDS. Padrão: claude-opus-5-5 (melhor qualidade).
# Para reduzir custo: claude-sonnet-5-5 ou claude-haiku-5-5.
CLAUDE_MODEL=claude-opus-5-5

# Imagens por IA: "openai" ou "nenhum" (sem IA, usa só o banco próprio e fotos enviadas)
IMAGE_PROVIDER=nenhum
OPENAI_API_KEY=
IMAGE_MODEL=gpt-image-1
